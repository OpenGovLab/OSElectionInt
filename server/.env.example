PORT=3050
# The en_usa database written by python/us_election
MONGODB_URL=mongodb://user:pass@host:27017/google_news_database_en_usa?authSource=admin
# Whoever already serves the 53 MB PMTiles archive; proxied, never copied
TILES_ORIGIN=https://app.perspectivity.co
# Optional — grounded Q&A panel; the panel reports it is unavailable without them
CLAWPY_URL=
CLAWPY_MODEL=
# Optional — address-level polling places
GOOGLE_CIVIC_API_KEY=

# ── Data backend ──────────────────────────────────────────────────────────
# Which engine serves the election corpus: mongo (default) or supabase.
# Mongo is authoritative — python/us_election writes it — and the Supabase
# copy is a reloadable mirror built by scripts/mongo_to_supabase.js.
DATA_BACKEND=mongo

# Required when DATA_BACKEND=supabase. The anon key is enough: every table is
# RLS read-only for anon, which is the correct privilege for a public,
# read-only civic dataset. Use the service-role key ONLY for the ETL.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Write access, for scripts/mongo_to_supabase.js. Bypasses RLS — keep it out
# of anything that ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, and preferred for a FULL load: a direct Postgres connection.
# scripts/mongo_to_supabase.js uses it when set (one multi-row INSERT per
# batch) and falls back to PostgREST when it is not, which is the usual case
# for a cloud project linked with an access token rather than a password.
# Local:  supabase start, then postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud:  Project Settings -> Database -> Connection string

# Both must come from the SAME project as SUPABASE_URL. A local URL paired
# with a cloud key fails as "No suitable key or wrong key type", which names
# neither the variable nor the mismatch.

# Direct Postgres connection, used ONLY by scripts/mongo_to_supabase.js.
# The ETL bulk-loads ~480k rows, which PostgREST is the wrong tool for.
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud:  Project Settings → Database → Connection string
SUPABASE_DB_URL=
