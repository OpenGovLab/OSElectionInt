{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* Mirrors Drishtikon.life/frontend/tsconfig.app.json deliberately.
       The page and its components are copied from there verbatim so the two
       can still be diffed; compiling them under stricter settings would mean
       editing the copies, and every edit is a place the two silently diverge. */
    "strict": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  /* Test files are excluded from the app build. They import node:test and
     node:assert, which need @types/node, and there is no runner wired yet —
     pulling Node's types into a browser bundle's typecheck to satisfy a file
     the bundle never includes is the wrong trade. Point a runner (vitest
     reuses vite.config.ts, alias included) at them when one is added. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
